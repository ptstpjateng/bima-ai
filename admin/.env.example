# Admin API base URL. Phase 1 calls /auth/login directly from the browser.
# In production this is https://bimaptsp.com/admin-api (Caddy-proxied on the VPS).
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:8001

# Random 32-byte secret used by NextAuth-style flows (Phase 2 will introduce
# server-side session signing). Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace_with_openssl_rand_base64_32

# Public base URL of SIAP Jateng's Filament admin panel. The case page's
# signature-assistant (Vision req #13) deep-links the Head of DPMPTSP to
# SIAP's "Tanda Tangan Berkas" page to perform the actual digital signature.
# BIMA never signs — SIAP owns TTE/BSRE. Defaults to Beta-SIAP if unset.
#   Beta:       https://beta-siap.bimaptsp.com
#   Production: https://perizinan.jatengprov.go.id  (set only on cutover)
NEXT_PUBLIC_SIAP_BASE_URL=https://beta-siap.bimaptsp.com

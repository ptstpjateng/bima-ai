# BIMA portal environment template.
# Copy to `.env.local` for local dev; on Vercel, configure these via the
# project dashboard (NEVER commit a real .env.local).

# ----------------------------------------------------------------------------
# admin-api integration (server-side only — used by /track/[ticket] page)
# ----------------------------------------------------------------------------
# Base URL of BIMA admin-api. Production points at the Caddy-proxied path.
# Local dev (admin-api running on :8001):  http://127.0.0.1:8001
BIMA_ADMIN_API_URL=https://nolongin.com/admin-api

# Shared secret for X-Internal-Key. Must match the value in
# admin-api/.env (INTERNAL_API_KEY). Never prefix with NEXT_PUBLIC_ —
# the browser must NOT see this.
BIMA_INTERNAL_API_KEY=CHANGE_ME_match_admin_api_internal_key

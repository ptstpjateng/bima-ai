# BIMA portal environment template.
# Copy to `.env.local` for local dev; on Vercel, configure these via the
# project dashboard (NEVER commit a real .env.local).

# ----------------------------------------------------------------------------
# admin-api integration
# ----------------------------------------------------------------------------
# Base URL of BIMA admin-api. Used server-side by:
#   - /track/[ticket]  page (X-Internal-Key gated, citizen-facing tracking)
#   - /api/sso/* Route Handlers (citizen SSO; bearer-token + cookie based —
#                                this path does NOT use X-Internal-Key)
#   - /me page (Server Component reads admin-api /sso/me with bearer token)
# Production points at the Caddy-proxied path.
# Local dev (admin-api running on :8001):  http://127.0.0.1:8001
BIMA_ADMIN_API_URL=https://nolongin.com/admin-api

# Shared secret for X-Internal-Key. Used ONLY by /track/[ticket] page to
# call admin-api's /tracking endpoint (which is X-Internal-Key gated, not
# JWT-gated, because citizen tracking is unauthenticated). Must match the
# value in admin-api/.env (INTERNAL_API_KEY). Never prefix with
# NEXT_PUBLIC_ — the browser must NOT see this.
BIMA_INTERNAL_API_KEY=CHANGE_ME_match_admin_api_internal_key

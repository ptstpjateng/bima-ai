# BIMA reverse proxy — replaces nginx/default.conf.
# Caddy auto-provisions and renews a Let's Encrypt cert for nolongin.com on first request.
#
# ─────────────────────────────────────────────────────────────────────────
# RATE LIMITING (restored 2026-06-02 — see security/caddy-rate-limit PR)
# ─────────────────────────────────────────────────────────────────────────
# Why: a Telegram webhook URL is a public secret-in-path; APTANA's outbound
# fan-out has burst behavior; chat + Meta WhatsApp endpoints can be abused
# to drain Gemma quota; /api + /admin-api/auth are credential-stuffing
# targets. Belt-and-suspenders with Laravel's throttle:120,1 and the
# ai-engine's per-user 5/min budget.
#
# Rules (per source IP, token-bucket):
#   • /webhook/*               → 30 requests / minute
#     Covers /webhook/telegram, /webhook/aptana, /webhook/meta_whatsapp,
#     /webhook/chat. Telegram + APTANA legitimate inbound is well under 30/m
#     per user — anything above is abuse or a misconfigured retry loop.
#   • /admin-api/*  /api/*     → 120 requests / minute
#     Matches the prior nginx limit; covers admin console XHR + Filament
#     livewire polling. Login endpoints inherit the same bucket — slow
#     enough to make credential stuffing unappealing without breaking UX.
#
# Anything over the bucket returns 429 with Retry-After.
#
# Plugin: github.com/mholt/caddy-ratelimit (compiled into the image via
# ./caddy/Dockerfile — switch docker-compose.yml `proxy` from
# `image: caddy:2-alpine` to `build: ./caddy` to pick it up).
#
# State is in-memory + container-local. If the proxy container restarts the
# buckets reset — fine for our threat model (no persistent attacker bypass
# from a restart; legitimate users are not affected).
#
# ─────────────────────────────────────────────────────────────────────────
# Other notes vs the legacy nginx config:
# - Security headers (HSTS, X-Frame-Options, etc.) are added here; the nginx config had none.
# - Path-specific timeouts ported: 120s for /webhook/* (Gemma p95 latency),
#   300s for everything backend-bound (Filament Excel imports take a while).

{
	# Replace before deploying — Let's Encrypt sends expiry-warning emails to this address.
	email rifqi.majid29@gmail.com

	# Enable the rate_limit module globally (it lives in the http app namespace
	# once registered; per-route activation happens inside the site block).
	order rate_limit before basicauth
}

# ──────────────────────────────────────────────
# Primary domains — nolongin.com (legacy) + bimaptsp.com (new brand).
# Both are served identically during the migration window; nolongin.com will
# be demoted to a 301-redirector once bimaptsp.com is stable (see the
# commented-out redirect block at the bottom of this file).
#
# ACME note: bimaptsp.com requires a SINGLE A record → 116.254.113.81.
# If a second A record (e.g. old registrar parking IP) exists, Let's
# Encrypt HTTP-01 validation will fail intermittently. Remove any extra
# A records at the registrar before reloading Caddy.
# ──────────────────────────────────────────────
nolongin.com, www.nolongin.com, bimaptsp.com, www.bimaptsp.com {
	encode gzip

	# Match nginx client_max_body_size 350M for Excel + PDF uploads
	request_body {
		max_size 350MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Hide upstream framework signal
		-Server
		-X-Powered-By
	}

	# AI-engine webhooks (Telegram, WhatsApp/APTANA, Meta-direct, web chat).
	# Path prefix is preserved — ai-engine routers expect /webhook/<channel>.
	# 600 r/m per source IP. NOTE: APTANA (the WhatsApp BSP) and Telegram both
	# relay ALL citizen inbound from a small set of their own server IPs, so a
	# per-{remote_host} cap is effectively a GLOBAL ceiling on the whole audience
	# — not per-citizen. 30/min throttled live demos (one message ≈ 3-4 webhook
	# hits: greeting + message + read + delivery). 600/min (10 r/s) keeps generous
	# headroom for a live audience while still capping direct abuse of the public
	# endpoint. FOLLOW-UP: key on the citizen msisdn at the app layer instead of
	# the relay IP so the limit is genuinely per-user.
	handle /webhook/* {
		rate_limit {
			zone webhooks {
				key {remote_host}
				events 600
				window 1m
			}
		}
		reverse_proxy ai-engine:8000 {
			transport http {
				read_timeout 120s
			}
		}
	}

	# Root → public portal. During migration window, both old and new portal
	# URLs are valid; bimaptsp.com visitors land on portal.bimaptsp.com.
	# Citizens who saved portal.nolongin.com/track/... links still work because
	# nolongin.com still resolves here.
	@bimaptsp_apex host bimaptsp.com www.bimaptsp.com
	handle @bimaptsp_apex {
		handle / {
			redir https://portal.bimaptsp.com 301
		}
		# Admin API on bimaptsp.com/admin-api/* — same upstream as nolongin.com
		handle_path /admin-api/* {
			reverse_proxy admin-api:8001 {
				transport http {
					read_timeout 60s
				}
			}
		}
		handle {
			reverse_proxy backend:80 {
				transport http {
					read_timeout 300s
					write_timeout 300s
					dial_timeout 60s
				}
				flush_interval -1
			}
		}
	}

	# nolongin.com routes (unchanged — keeps existing bookmarks working)
	handle / {
		redir https://portal.nolongin.com 301
	}

	# Admin API (FastAPI on internal admin-api:8001) — strips /admin-api prefix.
	# 120 r/m per source IP — see rate-limit block at top of file.
	handle_path /admin-api/* {
		rate_limit {
			zone admin_api {
				key {remote_host}
				events 120
				window 1m
			}
		}
		reverse_proxy admin-api:8001 {
			transport http {
				read_timeout 60s
			}
		}
	}

	# Laravel /api/* — same 120 r/m budget as /admin-api.
	# Declared before the catch-all `handle` so the matcher wins ordering.
	handle /api/* {
		rate_limit {
			zone laravel_api {
				key {remote_host}
				events 120
				window 1m
			}
		}
		reverse_proxy backend:80 {
			transport http {
				read_timeout 300s
				write_timeout 300s
				dial_timeout 60s
			}
			flush_interval -1
		}
	}

	# Everything else (sanctum, admin, livewire, css, js, fonts, storage, /up …)
	# → Laravel backend. flush_interval -1 streams responses immediately for Filament
	# Livewire long-polling. No rate limit here — Filament admin has its own auth gate
	# and Livewire polling would trip a low bucket.
	handle {
		reverse_proxy backend:80 {
			transport http {
				read_timeout 300s
				write_timeout 300s
				dial_timeout 60s
			}
			flush_interval -1
		}
	}
}

# ── FUTURE: once bimaptsp.com is the primary brand, uncomment this block
# ── and remove bimaptsp.com from the combined block above.
# nolongin.com, www.nolongin.com {
# 	redir https://bimaptsp.com{uri} 301
# }

# ──────────────────────────────────────────────
# Beta-SIAP Jateng — staging clone for BIMA integration testing, on both the
# old and new domain during migration. Lives behind beta-siap.nolongin.com /
# beta-siap.bimaptsp.com with the same Let's Encrypt auto-provisioning Caddy
# handles for nolongin.com. PII risk on this subdomain explicitly accepted by
# user on 2026-05-19 (real SIAP dump restored).
# No rate limit — internal-only test surface, traffic is BIMA-originated.
# ──────────────────────────────────────────────
beta-siap.nolongin.com, beta-siap.bimaptsp.com {
	encode gzip

	# Match nginx client_max_body_size 350M for SIAP's Excel + PDF + shapefile uploads
	request_body {
		max_size 350MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	reverse_proxy siap-beta:80 {
		transport http {
			# Match backend: 300s for Filament Excel imports + SHP scans
			read_timeout 300s
			write_timeout 300s
			dial_timeout 60s
		}
		flush_interval -1
	}
}

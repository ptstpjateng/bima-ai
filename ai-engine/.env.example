# APTANA WhatsApp BSP (replaces direct Meta Cloud API and Telegram)
# Dashboard: https://multichannel.aptana.co.id/  (Settings → Account)
# REST API: https://api-multichannel.aptana.co.id/api/v2/messages
APTANA_API_BASE=https://api-multichannel.aptana.co.id
APTANA_API_TOKEN=your_aptana_api_token_here
APTANA_SENDER_NUMBER=6285XXXXXXXXX  # provisioned WABA phone, E.164 WITHOUT +
# Path-based shared secret for inbound webhooks (APTANA does not HMAC-sign).
# Generate with: openssl rand -hex 32
# Use the SAME value in the APTANA webhook URL: /webhook/aptana/inbound/<this>
APTANA_PATH_SECRET=generate_with_openssl_rand_hex_32

# Laravel TALL Backend (internal Docker network)
LARAVEL_BACKEND_URL=http://backend:80
LARAVEL_API_KEY=your_internal_api_key_here

# LLM — Google AI Studio. Same API key works for both Gemma + Gemini.
#
# CITIZEN CHAT MODEL (the main reply path).
# Current default: gemma-3-27b-it (open-weights via Google AI Studio,
#   no GPU needed; ~5-8s per reply; "vendor-neutral on weights").
# FASTER ALTERNATIVE: models/gemini-2.5-flash
#   - ~3-4x speedup (~1.5-3s per reply)
#   - same Google AI Studio billing, same key
#   - supports function calling AND vision (Gemma 27b doesn't)
#   - tradeoff: loses "open weights" property (we never self-hosted Gemma
#     anyway, so this is paper-thin in practice)
#   - flip this var to switch — no other code changes needed
#   - see [[LLM Performance & UX]] §"3. Switch citizen chat to Gemini 2.5 Flash"
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=models/gemma-3-27b-it
# Optional: separate smaller model for intent classification (faster/cheaper).
# Leave blank to reuse GEMINI_MODEL. Recommended: models/gemma-3-4b-it
GEMINI_INTENT_MODEL=
# Model-fallback ladder for the citizen-chat path. When the primary model
# (GEMINI_MODEL) returns 429/503 from Google capacity hiccups,
# _call_gemma_with_fallback walks this list in order. Same API key works
# for all of them. Set to empty string to disable (single-model behavior).
# Default below: Gemini Pro (slower, rarely 503s) → hosted Gemma 3 27b (open-weights).
GEMINI_FALLBACK_MODELS=models/gemini-2.5-pro,models/gemma-3-27b-it

# ChromaDB
CHROMA_DB_PATH=/app/chroma_db

# SIAP Jateng — DPMPTSP Central Java production licensing system.
# Read-only Sanctum-protected v1 API. BIMA calls /api/v1/monitoring-berkas
# when a citizen WhatsApps a permit-status question (e.g. "status izin 000077591").
# Token issued by SIAP via POST /api/v1/login {email, password, device_name}.
# Leave SIAP_API_TOKEN blank to disable the fast-path (everything falls
# through to Gemma — useful in environments where SIAP isn't reachable).
SIAP_API_BASE=http://127.0.0.1:8500
SIAP_API_TOKEN=
SIAP_TIMEOUT_SECONDS=8

# SIAP WRITE seam — officer-copilot write actions (Wave 2).
# The officer copilot's two write tools — forward_case and record_decision
# (services/agents/officer_copilot.py) — call SIAP's state-changing
# endpoints via services/siap_write_client.py:
#   POST /api/v1/license-request/{id}/forward   (ability: workflow:advance)
#   POST /api/v1/license-request/{id}/decision  (ability: decision:draft)
# This token is DISTINCT from SIAP_API_TOKEN (read-only) and
# SIAP_EVENTS_API_TOKEN (events:read only): it must carry BOTH the
# `workflow:advance` and `decision:draft` Sanctum abilities. Mint it on
# Beta-SIAP with:
#   php artisan bima:issue-token --user=bima@dpmptsp.go.id \
#       --abilities=workflow:advance,decision:draft --name=bima-copilot-write
# Keeping it separate from the read token is the point of SIAP's scoped
# abilities — a leaked read token cannot forward or decide a case.
# Blank → the copilot's write tools degrade gracefully: they return a clear
# "not configured" result instead of crashing, and never call SIAP.
# The write client reuses SIAP_API_BASE (above) for the host.
SIAP_WRITE_API_TOKEN=
# Write requests can run a short DB transaction on the SIAP side; give them
# a touch more headroom than the 8 s read timeout.
SIAP_WRITE_TIMEOUT_SECONDS=15

# SIAP SUBMISSION seam — guided citizen submission (Wave 3, Vision req #4).
# BIMA's guided-submission flow (services/guided_submission.py) walks a
# citizen through filing a SIAP licence application over WhatsApp, then
# files it via services/siap_submission_client.py:
#   POST /api/v1/license-request   (ability: submission:create)
# This token is DISTINCT from every other SIAP token BIMA holds
# (SIAP_API_TOKEN read-only, SIAP_WRITE_API_TOKEN officer-writes,
# SIAP_EVENTS_API_TOKEN events:read). It must carry ONLY the
# `submission:create` Sanctum ability. Mint it on Beta-SIAP with:
#   php artisan bima:issue-token --user=bima@dpmptsp.go.id \
#       --abilities=submission:create --name=bima-guided-submission
# Blank → the guided-submission flow degrades gracefully: it validates the
# citizen's data but reports "submission channel not ready" instead of
# crashing, and never calls SIAP. The client reuses SIAP_API_BASE (above).
SIAP_SUBMISSION_API_TOKEN=
# Creating a request runs a DB transaction + ticket allocation on the SIAP
# side; same headroom as the officer write client.
SIAP_SUBMISSION_TIMEOUT_SECONDS=15

# SIAP tool layer — direct read-only Postgres connection ([[Decisions]] §22,
# [[SIAP API Inventory]] Half 2). SIAP exposes no REST endpoint for its
# licence catalogue / requirements / step history, so the Tier-1 SIAP tools
# (services/siap_tools.py) read the `dbsiapjateng` database directly.
#   - DISCRETE vars, not a DSN string: a postgresql://user:pw@host/db DSN
#     breaks when the password contains URL-special chars (@ / : ? #) —
#     asyncpg misparses host as garbage. The BIMA DB password has such
#     chars, so we pass host/user/password as separate kwargs instead.
#   - On the VPS, ai-engine reaches Postgres over the Docker network at
#     host `postgres`, port 5432, database `dbsiapjateng`.
#   - READ-ONLY: every query is a parameterised SELECT and the pool forces
#     `default_transaction_read_only=on` on every connection. Production
#     should get a SELECT-only `bima_readonly` role from the SIAP team
#     (blocker B1 in the SIAP API Inventory). Until then the `bima`
#     superuser works — the read-only-transaction guard is the safety net.
#   - Leave SIAP_DB_HOST (or SIAP_DB_USER) blank to disable the SIAP tool
#     layer (tools then return a structured "not configured" result and
#     the agent degrades gracefully).
SIAP_DB_HOST=
SIAP_DB_PORT=5432
SIAP_DB_NAME=dbsiapjateng
SIAP_DB_USER=
SIAP_DB_PASSWORD=

# Public deep-link base for the BIMA portal tracking page. Used in
# WhatsApp status replies so citizens can click through to richer detail.
PORTAL_TRACK_URL_BASE=https://portal.nolongin.com/track

# Public base of SIAP Jateng's Filament admin panel — used by the copilot's
# signature-assistant mode (Vision req #13) to deep-link the Head of DPMPTSP
# to SIAP's "Tanda Tangan Berkas" page so they sign there. BIMA never signs;
# SIAP owns TTE/BSRE. Defaults to Beta-SIAP if unset.
#   Beta:       https://beta-siap.nolongin.com
#   Production: https://perizinan.jatengprov.go.id  (set only on cutover)
SIAP_SIGNING_URL_BASE=https://beta-siap.nolongin.com

# Service-to-service auth — INBOUND validation for the validator router.
# Must match admin-api's INTERNAL_API_KEY (admin-api calls /v1/validator/*).
# Falls back to LARAVEL_API_KEY if INTERNAL_API_KEY is unset (legacy alias).
INTERNAL_API_KEY=

# Gemini Vision — used by the submission completion validator agent
# ([[BIMA Vision]] req #6). Separate from GEMINI_MODEL (which is Gemma
# for citizen chat) because vision tasks need multimodal capability.
# Same GEMINI_API_KEY is reused. Default model = 2.5-flash (good
# speed/quality balance, supports responseSchema structured output).
GEMINI_VISION_MODEL=models/gemini-2.5-flash
GEMINI_TOOL_MODEL=models/gemini-2.5-flash
GEMINI_VISION_TIMEOUT_SECONDS=30

# Proactive notification dispatcher (services/notifications.py).
# Master kill-switch for outbound BIMA-initiated WhatsApp pings:
#   new_case / sla_warn / citizen_progress / citizen_completed / citizen_needs_fix
# Default OFF so an accidental call to notify() during Meta's approval
# window doesn't fire a 132xxx (template not approved). Flip to "true"
# the moment all five templates are approved in APTANA + Meta.
# Templates + parameter shapes are documented in Decisions.md §20.
BIMA_NOTIFICATIONS_ENABLED=false

# Transparency-notification poller (services/transparency_poller.py).
# A background loop that polls SIAP's license-request changes feed
# (GET /api/v1/license-request/changes) and dispatches proactive citizen
# WhatsApp updates as a permit moves through SIAP's approval chain
# ([[BIMA Vision]] req #12). Maps SIAP status → citizen_progress /
# citizen_completed / citizen_needs_fix.
#
# Feature flag — default OFF. The loop task is always created at startup
# but no-ops every tick until this is "true". Keep OFF until the SIAP
# events token below is provisioned on the VPS. NOTE: a real WhatsApp
# send ALSO requires BIMA_NOTIFICATIONS_ENABLED=true — both flags must
# be on. Leaving either off makes the poller a safe no-op.
BIMA_TRANSPARENCY_POLLER_ENABLED=false
#
# SIAP Sanctum bearer token for the changes feed. This is DISTINCT from
# SIAP_API_TOKEN above (the monitoring-berkas token) — the changes feed
# requires a token with the `events:read` ability. Mint it on Beta-SIAP
# with:  php artisan bima:issue-token  (a DEPLOY step). Blank → the
# poller logs once and no-ops; it never crashes. The poller reuses
# SIAP_API_BASE (above) for the host.
SIAP_EVENTS_API_TOKEN=
#
# Poll cadence in seconds. 60s balances "feels proactive" against not
# hammering SIAP. Per-page change limit caps how many changes one tick
# processes.
TRANSPARENCY_POLL_INTERVAL_SECONDS=60
TRANSPARENCY_POLL_LIMIT=50
TRANSPARENCY_HTTP_TIMEOUT_SECONDS=10
#
# Cold-start guard. On the first run (cursor file absent) SIAP replays
# its whole backlog. This caps how many of those historical changes a
# single tick turns into notifications — the rest still advance the
# cursor (treated as already-seen) so they are never replayed. Default 0
# = notify nothing from the backlog (only changes that happen AFTER the
# poller first runs trigger a WhatsApp). Raise it only if you want the
# poller to "catch up" on recent history at go-live.
TRANSPARENCY_INITIAL_CATCHUP_CAP=0
#
# Where the monotonic poll cursor is persisted (a small JSON file,
# written atomically). Must survive a container restart — point it at a
# mounted volume on the VPS. The directory is created if missing.
TRANSPARENCY_CURSOR_PATH=/app/data/transparency_cursor.json

# Demo fixtures for the submission validator. When true, callers can pass
# ?demo_fixture=clean|name_mismatch|nik_typo to /v1/validator/submission
# and get a canned ValidateResponse with no Gemini Vision call. Lets the
# bima-admin case page demo the killer feature deterministically on stage
# (no PII, no quota burn, no flaky OCR). FLIP TO false FOR PROD —
# demo fixtures bypass Gemini and return canned data.
ENABLE_DEMO_FIXTURES=true

# Guided submission flow (services/guided_submission.py, Wave 3 — Vision
# req #4). BIMA conversationally walks a citizen through filing a real SIAP
# licence application over WhatsApp: detect intent → resolve the licence →
# collect the applicant fields over multiple turns → validate → submit.
#
# Feature flag — default OFF. While off, the guided-submission fast path in
# ai_handler is a no-op and citizen chat behaves exactly as before. Keep OFF
# until SIAP_SUBMISSION_API_TOKEN is provisioned on the VPS and the flow is
# verified against Beta-SIAP. Flip to "true" to activate.
BIMA_GUIDED_SUBMISSION_ENABLED=false
#
# Which validator demo fixture the guided flow validates against before
# submitting (ai-engine/tests/fixtures/<name>.json). "clean" is the
# happy-path default so the flow demonstrates a real end-to-end submit.
# This is the interim document-validation path: real document-upload-over-
# WhatsApp intake is a documented follow-up slice — see the module docstring
# in services/guided_submission.py.
GUIDED_SUBMISSION_DEMO_FIXTURE=clean
#
# SIAP profile_id the guided flow files the request under. SIAP's create
# endpoint needs a numeric profile_id; per-citizen profile resolution from
# NIK is a SIAP-side lookup BIMA does not yet have — so for Wave 3 rehearsal
# this pins a known Beta-SIAP test profile. Blank → the flow validates the
# citizen's data but reports the channel is not ready instead of submitting.
GUIDED_SUBMISSION_PROFILE_ID=

# Meta Cloud API (WhatsApp Business) — LEGACY; superseded by APTANA below.
# Kept while the old _send_whatsapp_reply path in ai_handler.py is still wired up;
# delete this block once the APTANA pipeline is fully cut over.
WHATSAPP_APP_SECRET=your_meta_app_secret_here
WHATSAPP_API_TOKEN=your_meta_permanent_access_token_here
WHATSAPP_API_VERSION=v19.0

# APTANA WhatsApp BSP (replaces direct Meta Cloud API)
# Dashboard: https://multichannel.aptana.co.id/  (Settings → Account)
# REST API: https://api-multichannel.aptana.co.id/api/v2/messages
APTANA_API_BASE=https://api-multichannel.aptana.co.id
APTANA_API_TOKEN=your_aptana_api_token_here
APTANA_SENDER_NUMBER=6285XXXXXXXXX  # provisioned WABA phone, E.164 WITHOUT +
# Path-based shared secret for inbound webhooks (APTANA does not HMAC-sign).
# Generate with: openssl rand -hex 32
# Use the SAME value in the APTANA webhook URL: /webhook/aptana/inbound/<this>
APTANA_PATH_SECRET=generate_with_openssl_rand_hex_32

# Telegram Bot API
TELEGRAM_SECRET_TOKEN=your_telegram_webhook_secret_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Laravel TALL Backend (internal Docker network)
LARAVEL_BACKEND_URL=http://backend:80
LARAVEL_API_KEY=your_internal_api_key_here

# LLM — Hosted Gemma via Google AI Studio (open-weights, no VPS GPU needed)
# Primary: gemma-4-26b-a4b-it | Lighter: gemma-3-12b-it | Fastest: gemma-3-4b-it
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=models/gemma-4-26b-a4b-it
# Optional: separate smaller model for intent classification (faster/cheaper).
# Leave blank to reuse GEMINI_MODEL. Recommended: models/gemma-3-4b-it
GEMINI_INTENT_MODEL=

# ChromaDB
CHROMA_DB_PATH=/app/chroma_db

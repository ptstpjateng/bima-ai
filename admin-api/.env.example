# BIMA admin-api environment template.
# Copy to `.env` for local dev; never commit a real .env.

# ----------------------------------------------------------------------------
# Runtime environment
# ----------------------------------------------------------------------------
# One of: development | staging | production. When set to `staging` or
# `production`, the app REFUSES to start if SECRET_KEY or INTERNAL_API_KEY
# still look like the placeholders below (regex match on "change-me",
# "placeholder", "your-...-here", or length < 32 chars). This guards against
# shipping the in-code defaults — they would let anyone mint admin JWTs or
# forge X-Internal-Key calls.
APP_ENV=development

# ----------------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------------
# asyncpg driver — note the +asyncpg suffix.
# Inside Docker, host is `postgres` (the compose service name).
# Locally you might use postgresql+asyncpg://bima:bima@localhost:5432/bima_ai
DATABASE_URL=postgresql+asyncpg://bima:CHANGE_ME@postgres:5432/bima_ai

# ----------------------------------------------------------------------------
# Service-to-service auth
# ----------------------------------------------------------------------------
# Must match the value used by ai-engine + data-pipeline + (legacy) Laravel.
# Rotate per Decisions §3 (assume current value compromised).
# In APP_ENV=production/staging this value MUST NOT match a placeholder
# (e.g. contain "change-me", "CHANGE_ME", or be shorter than 32 chars) —
# the app will refuse to start otherwise.
INTERNAL_API_KEY=CHANGE_ME_match_existing_laravel_value

# ----------------------------------------------------------------------------
# JWT signing
# ----------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
# In APP_ENV=production/staging this value MUST NOT match a placeholder
# (e.g. contain "change-me", "CHANGE_ME", or be shorter than 32 chars) —
# the app will refuse to start otherwise.
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRY_DAYS=7

# ----------------------------------------------------------------------------
# CORS / trusted hosts
# ----------------------------------------------------------------------------
# Comma-separated list. NO wildcards in prod.
# Dev:  http://localhost:3000
# Prod: https://admin.nolongin.com
ADMIN_FRONTEND_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# ai-engine cross-service
# ----------------------------------------------------------------------------
# Internal base URL of ai-engine. Used by the dashboard ChromaDB probe and
# by /case/{ticket}/validate which proxies to ai-engine's submission
# validator (POST /v1/validator/submission, gated by X-Internal-Key).
# Inside Docker, host is `ai-engine` (the compose service name).
AI_ENGINE_URL=http://ai-engine:8000

# ----------------------------------------------------------------------------
# SIAP Jateng (read-only Sanctum API)
# ----------------------------------------------------------------------------
# DPMPTSP Central Java production licensing system. The /tracking/{ticket}
# router calls SIAP's monitoring-berkas endpoint and renders permit status
# for the BIMA portal.
# Token issued by SIAP via POST /api/v1/login {email, password, device_name}.
# Leave SIAP_API_TOKEN blank to disable — endpoint will then return 503.
SIAP_API_BASE=http://127.0.0.1:8500
SIAP_API_TOKEN=
SIAP_TIMEOUT_SECONDS=8

# ----------------------------------------------------------------------------
# SIAP Jateng (direct DB read for citizen SSO)
# ----------------------------------------------------------------------------
# The /sso/login endpoint looks up `ptsp.person_profile` directly to map a
# 16-digit NIK to a citizen profile_id. Must use the +asyncpg driver.
# Leave empty to disable SSO — endpoint will return 503.
#
# Local dev:  postgresql+asyncpg://siapjateng@127.0.0.1:5432/dbsiapjateng
# Production: set to the production SIAP DSN.
SIAP_DATABASE_URL=postgresql+asyncpg://siapjateng@127.0.0.1:5432/dbsiapjateng

# ----------------------------------------------------------------------------
# Logging
# ----------------------------------------------------------------------------
LOG_LEVEL=INFO
